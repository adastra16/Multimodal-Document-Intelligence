APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# SQLite is the default laptop-friendly store. Runtime files live under DATA_DIR.
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# OpenAI-compatible LLM endpoint (Ollama locally, or Groq/Gemini-compatible APIs).
# Leave LLM_API_KEY empty for local Ollama. Never commit a real key.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Tesseract OCR for scanned / image-only pages. Native-text PDFs do not need this binary.
OCR_COMMAND=tesseract
OCR_LANGUAGE=eng
OCR_DPI=220
